<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Verso.Worker</AssemblyName>
    <RootNamespace>Verso.Worker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="Sentry.Extensions.Logging" Version="7.0.1" />
    <PackageDownload Include="Microsoft.ML.OnnxRuntime" Version="[1.23.2]" />
    <ProjectReference Include="..\Verso.Core\Verso.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)microsoft.ml.onnxruntime/1.23.2/runtimes/**/native/*"
      Exclude="$(NuGetPackageRoot)microsoft.ml.onnxruntime/1.23.2/runtimes/android/**;$(NuGetPackageRoot)microsoft.ml.onnxruntime/1.23.2/runtimes/ios/**"
      Link="parakeet-onnx/%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
      ExcludeFromSingleFile="true" Condition="'$(RuntimeIdentifier)' == ''" />
    <Content Include="$(NuGetPackageRoot)microsoft.ml.onnxruntime/1.23.2/runtimes/$(RuntimeIdentifier)/native/*"
      Link="parakeet-onnx/$(RuntimeIdentifier)/native/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
      ExcludeFromSingleFile="true" Condition="'$(RuntimeIdentifier)' != ''" />
  </ItemGroup>

</Project>
